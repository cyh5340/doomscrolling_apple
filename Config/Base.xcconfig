// Build settings for every target. Override any of these in Config/Local.xcconfig (git-ignored),
// e.g. to point at your Supabase project and set your Apple team. See TODO.md.
//
// xcconfig treats "//" as a comment, so URLs are written with "/$()/".

// Defaults target the local Supabase stack (`npx supabase start` in the Android repo's backend/).
SUPABASE_URL = http:/$()/127.0.0.1:54321
SUPABASE_KEY = sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
INVITE_HOST = doomscroll.example

BUNDLE_ID_PREFIX = com.doomscroll
APP_GROUP = group.com.doomscroll.app
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
